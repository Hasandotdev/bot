generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id                 String   @id @default(cuid())
  name               String
  company            String?
  username           String   @unique
  passwordHash       String
  passwordSalt       String
  email              String?
  phone              String?
  domains            String[] @default([])
  createdAt          DateTime @default(now())

  settings           Settings?
  knowledgeEntries   KnowledgeEntry[]
  services           Service[]
  packages           Package[]
  products           Product[]
  contacts           Contact[]
  chatLogs           ChatLog[]
}

model Settings {
  id                 String   @id @default(cuid())
  clientId           String   @unique
  client             Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name               String   @default("Admin")
  avatar             String?
  colorsPrimary      String   @default("#2563eb")
  logo               String?
  locations          String?
  emailNotifications Boolean  @default(false)
}

model KnowledgeEntry {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label     String
  topic     String?
  content   String
  createdAt DateTime @default(now())

  @@index([clientId])
}

model Service {
  id                  String   @id @default(cuid())
  clientId            String
  client              Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  qualifyingQuestions String[] @default([])
  engagementQuestions String[] @default([])
  features            String[] @default([])

  @@index([clientId])
}

model Package {
  id        String @id @default(cuid())
  clientId  String
  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service   String
  packages  Json   // { Basic: {price, features}, Standard: {...}, Premium: {...} }

  @@index([clientId])
}

model Product {
  id          String  @id @default(cuid())
  clientId    String
  client      Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  stack       String?
  category    String?
  priceRange  String?
  description String?

  @@index([clientId])
}

model Contact {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String?
  email     String?
  phone     String?
  company   String?
  createdAt DateTime @default(now())

  @@index([clientId])
}

model ChatLog {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  visitorId   String   // groups messages into one conversation (was your "clientId" param in chatLogService)
  role        String   // 'user' | 'assistant'
  content     String
  leadName    String?
  leadEmail   String?
  leadPhone   String?
  leadCompany String?
  createdAt   DateTime @default(now())

  @@index([clientId, visitorId])
}